<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS uniquement, autorités de certification du système seulement (pas celles ajoutées par l'utilisateur). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
